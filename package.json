{
  "name": "meetwell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/web.ts dev --hostname 127.0.0.1",
    "worker": "tsx apps/worker/src/main.ts",
    "build": "pnpm --filter @meetwell/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @meetwell/web typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "benchmark:explore": "tsx scripts/benchmark-explore.ts",
    "seed:explore-venue": "tsx scripts/seed-explore-venue.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:accounts": "tsx scripts/setup-accounts.ts",
    "staff:grant": "tsx scripts/grant-staff.ts",
    "staff:revoke": "tsx scripts/grant-staff.ts --revoke",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "setup:native": "bash scripts/setup-native.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:e2e",
    "db:grant-local-worker": "tsx scripts/grant-local-worker.ts",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-services.ps1 setup",
    "services:windows:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-services.ps1 start",
    "services:windows:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-services.ps1 stop",
    "services:windows:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-services.ps1 status"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
