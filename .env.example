# Local synthetic development only. Never reuse these credentials in hosting.
MIGRATION_DATABASE_URL=postgresql://meetwell_dev:local-development-only@127.0.0.1:5432/meetwell_dev
# Provision a separate login with meetwell_worker membership; see README.
WORKER_DATABASE_URL=postgresql://meetwell_worker_dev:local-worker-only@127.0.0.1:5432/meetwell_dev
TEST_DATABASE_URL=postgresql://meetwell_dev:local-development-only@127.0.0.1:5432/meetwell_test
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=meetwell-local
MINIO_ROOT_PASSWORD=local-storage-only
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Plaintext is allowed only for loopback local mode. Else use implicit or starttls.
SMTP_TLS=none
# Supply SMTP_USER/SMTP_PASS only if the selected TLS relay requires authentication.
# BACKUP_ENCRYPTION_KEY is separate 32-byte random base64, held outside backups.
# BACKUP_DATABASE_URL/RESTORE_CLUSTER_URL are operator-only, never web/worker config.
# setup:accounts generates separate IDENTITY, APP, OPS and SAFETY_DATABASE_URL
# logins plus their TEST_ equivalents. SAFETY_ENCRYPTION_KEY is generated locally.
# Never copy generated keys or passwords into this template.
